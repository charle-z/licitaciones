{
  "name": "carlos-acosta/licitaciones",
  "description": "Modulo de ofertas y documentos con PHP MVC y Vue",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "ext-zip": "*",
    "illuminate/database": "^12.0",
    "openspout/openspout": "^5.12"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "scripts": {
    "test": "phpunit",
    "lint": "php tools/lint.php"
  },
  "config": {"sort-packages": true, "allow-plugins": {}, "platform": {"php": "8.4.27"}}
}
